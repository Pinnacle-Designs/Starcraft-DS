{
  "name": "starcraft-ds",
  "version": "1.0.18",
  "private": true,
  "description": "AI screen-capture counter coach for StarCraft II",
  "main": "electron/main.cjs",
  "author": "pinnacle-designs",
  "repository": {
    "type": "git",
    "url": "https://github.com/pinnacle-designs/Starcraft-DS.git"
  },
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "kill-ports": "node scripts/kill-dev-ports.cjs",
    "ensure-ollama": "node scripts/ensure-ollama.cjs",
    "fetch-unit-images": "node scripts/fetch-unit-images.cjs",
    "export-training": "node scripts/export-training-dataset.cjs",
    "copy:data": "node scripts/copy-data-for-client.cjs",
    "dev": "npm run kill-ports && node scripts/ensure-ollama.cjs && concurrently -n server,client -c blue,green \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix server && npm run build --prefix client",
    "build:pages": "node scripts/build-pages.cjs",
    "build:desktop": "node scripts/build-desktop.cjs",
    "dist:win": "npm run build:desktop && electron-builder --win",
    "dist:mac": "npm run build:desktop && electron-builder --mac",
    "print-installer-url": "node scripts/publish-installer-url.cjs",
    "upload-installer:r2": "node scripts/upload-installer-to-r2.cjs",
    "upload-installer:r2:aws": "bash scripts/upload-to-r2-awscli.sh",
    "generate-app-icon": "node scripts/generate-app-icon.cjs",
    "prepare-server-pack": "node scripts/prepare-server-pack.cjs",
    "electron": "electron electron/main.cjs",
    "electron:dev": "npm run kill-ports && node scripts/ensure-ollama.cjs && concurrently -n server,client,electron -c blue,green,magenta \"npm run dev --prefix server\" \"npm run dev --prefix client\" \"wait-on http://localhost:5173 http://localhost:3847/api/health && electron electron/main.cjs\""
  },
  "build": {
    "appId": "com.starcraftds.coach",
    "productName": "Starcraft Coach",
    "copyright": "Copyright © Pinnacle Designs",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "afterPack": "scripts/embed-win-icon.cjs",
    "compression": "store",
    "icon": "build/icon.ico",
    "files": [
      "electron/**/*",
      "package.json",
      "node_modules/electron-updater/**/*"
    ],
    "extraResources": [
      {
        "from": "electron/app-icon.ico",
        "to": "app-icon.ico"
      },
      {
        "from": "electron/app-icon.png",
        "to": "app-icon.png"
      },
      {
        "from": "client/dist",
        "to": "client/dist"
      },
      {
        "from": "server/dist",
        "to": "server/dist"
      },
      {
        "from": "server/package.json",
        "to": "server/package.json"
      },
      {
        "from": "server/node_modules",
        "to": "server/node_modules",
        "filter": [
          "**/*",
          "!starcraft-ds/**"
        ]
      },
      {
        "from": "data",
        "to": "data",
        "filter": [
          "**/*",
          "!training/samples/**"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signExecutable": false,
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "artifactName": "Starcraft-Coach-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Starcraft Coach",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "artifactName": "Starcraft-Coach-Setup-${version}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "Pinnacle-Designs",
      "repo": "Starcraft-DS",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1063.0",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.2",
    "resedit": "^1.7.2",
    "sharp": "^0.33.5",
    "to-ico": "^1.1.5",
    "wait-on": "^8.0.1"
  }
}
