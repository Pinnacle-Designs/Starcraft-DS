# Vision: auto = Ollama visual AI (no unit names needed) with OCR fallback.
VISION_PROVIDER=auto

# Start Ollama on this machine when the API boots (set false if you manage Ollama yourself)
AUTO_START_OLLAMA=true

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=llava

# Send unit portrait collage as a second image to help llava match sprites (default on)
# OLLAMA_USE_REFERENCE_IMAGE=false

# Skip model download on startup (you already ran ollama pull llava)
# SKIP_OLLAMA_PULL=true

# Cloud vision (optional)
OPENAI_API_KEY=sk-your-key-here
OPENAI_VISION_MODEL=gpt-4o-mini

PORT=3847
