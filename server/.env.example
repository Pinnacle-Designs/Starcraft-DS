# Vision: auto prefers Ollama (local), then OpenAI
# VISION_PROVIDER=auto|ollama|openai

# Local vision (no API key) — install Ollama and run: ollama pull llava
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=llava

# Cloud vision (optional)
OPENAI_API_KEY=sk-your-key-here
OPENAI_VISION_MODEL=gpt-4o-mini

PORT=3847
